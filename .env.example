# NestJS API base URL (leave empty to use local mock data)
VITE_POS_STORE_API_URL=

# Public shop/blog API origin; empty uses a same-origin /api proxy.
VITE_PUBLIC_API_URL=http://localhost:3000

# Main landing hostnames, comma-separated. Other hosts require verified domain mapping.
VITE_PLATFORM_HOSTS=sanjab.app,www.sanjab.app
